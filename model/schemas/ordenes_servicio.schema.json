{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ordenes_servicio",
  "type": "object",
  "required": [
    "cliente",
    "bicicleta",
    "fechaRecepcion",
    "fechaEstimadaEntrega",
    "coordinadorResponsable",
    "tecnicosAsignados",
    "estado",
    "recepcion",
    "historialCambiosEstado"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Identificador único"
    },
    "citaId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Cita vinculada cuando corresponda"
    },
    "cliente": {
      "type": "object",
      "required": [
        "usuarioId",
        "nombreCompleto",
        "documentoIdentificacion",
        "numeroTelefono",
        "correoElectronico"
      ],
      "description": "Cliente",
      "properties": {
        "usuarioId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        },
        "nombreCompleto": {
          "type": "string"
        },
        "documentoIdentificacion": {
          "type": "string"
        },
        "numeroTelefono": {
          "type": "string"
        },
        "correoElectronico": {
          "type": "string"
        },
        "direccion": {
          "type": "string"
        }
      }
    },
    "bicicleta": {
      "type": "object",
      "required": [
        "bicicletaId",
        "marca",
        "modelo",
        "tipo",
        "color"
      ],
      "description": "Bicicleta",
      "properties": {
        "bicicletaId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        },
        "marca": {
          "type": "string"
        },
        "modelo": {
          "type": "string"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "urbana",
            "ruta",
            "montaña",
            "eléctrica"
          ]
        },
        "color": {
          "type": "string"
        },
        "numeroSerie": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fechaRecepcion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de recepción"
    },
    "fechaEstimadaEntrega": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha estimada de entrega"
    },
    "coordinadorResponsable": {
      "type": "object",
      "required": [
        "coordinadorId",
        "nombreCompleto"
      ],
      "description": "Coordinador responsable",
      "properties": {
        "coordinadorId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        },
        "nombreCompleto": {
          "type": "string"
        }
      }
    },
    "tecnicosAsignados": {
      "type": "array",
      "description": "Técnicos asignados",
      "items": {
        "type": "object",
        "required": [
          "tecnicoId",
          "nombreCompleto"
        ],
        "properties": {
          "tecnicoId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "nombreCompleto": {
            "type": "string"
          }
        }
      }
    },
    "estado": {
      "type": "string",
      "enum": [
        "recibida",
        "en diagnóstico",
        "pendiente de autorización",
        "en ejecución",
        "lista para entrega",
        "entregada",
        "cancelada"
      ],
      "description": "Estado correspondiente"
    },
    "recepcion": {
      "type": "object",
      "required": [
        "problemaReportado",
        "condicionesObservadas"
      ],
      "description": "Al recibir la bicicleta",
      "properties": {
        "problemaReportado": {
          "type": "string",
          "description": "Problema reportado"
        },
        "condicionesObservadas": {
          "type": "string",
          "description": "Condiciones observadas"
        },
        "accesoriosEntregados": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Accesorios entregados"
        },
        "fotografias": {
          "type": "array",
          "description": "Fotografías cuando sea necesario",
          "items": {
            "type": "object",
            "required": [
              "nombreArchivo",
              "descripcion",
              "ubicacion"
            ],
            "properties": {
              "nombreArchivo": {
                "type": "string",
                "description": "Nombre del archivo"
              },
              "descripcion": {
                "type": "string",
                "description": "Descripción"
              },
              "ubicacion": {
                "type": "string",
                "description": "Ubicación"
              }
            }
          }
        }
      }
    },
    "diagnostico": {
      "type": "object",
      "description": "Durante el diagnóstico",
      "properties": {
        "componentesRevisados": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Componentes revisados"
        },
        "condicion": {
          "type": "string",
          "description": "Su condición"
        },
        "hallazgos": {
          "type": "array",
          "description": "Hallazgos",
          "items": {
            "type": "object",
            "required": [
              "componente",
              "descripcion",
              "prioridadAtencion",
              "observaciones"
            ],
            "properties": {
              "componente": {
                "type": "string",
                "description": "Componente"
              },
              "descripcion": {
                "type": "string",
                "description": "Descripción"
              },
              "prioridadAtencion": {
                "type": "string",
                "description": "Prioridad de atención"
              },
              "observaciones": {
                "type": "string",
                "description": "Observaciones"
              },
              "evidencias": {
                "type": "array",
                "description": "Fotografías o documentos adjuntos",
                "items": {
                  "type": "object",
                  "required": [
                    "nombreArchivo",
                    "descripcion",
                    "ubicacion"
                  ],
                  "properties": {
                    "nombreArchivo": {
                      "type": "string",
                      "description": "Nombre del archivo"
                    },
                    "descripcion": {
                      "type": "string",
                      "description": "Su descripción"
                    },
                    "ubicacion": {
                      "type": "string",
                      "description": "Su ubicación"
                    }
                  }
                }
              }
            }
          }
        },
        "accionesRecomendadas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Acciones recomendadas"
        }
      }
    },
    "propuesta": {
      "type": "object",
      "description": "Propuesta de intervención",
      "properties": {
        "trabajos": {
          "type": "array",
          "description": "Uno o varios trabajos",
          "items": {
            "type": "object",
            "required": [
              "servicioODescripcion",
              "componenteInvolucrado",
              "costoEstimadoManoObra",
              "repuestosPrevistos",
              "observaciones"
            ],
            "properties": {
              "servicioODescripcion": {
                "type": "string",
                "description": "Servicio o descripción de la intervención"
              },
              "componenteInvolucrado": {
                "type": "string",
                "description": "Componente involucrado"
              },
              "costoEstimadoManoObra": {
                "type": "number",
                "description": "Costo estimado de mano de obra"
              },
              "repuestosPrevistos": {
                "type": "array",
                "description": "Repuestos previstos",
                "items": {
                  "type": "object",
                  "required": [
                    "nombre",
                    "especificacionesRelevantes",
                    "cantidad",
                    "precioUnitarioEstimado"
                  ],
                  "properties": {
                    "nombre": {
                      "type": "string",
                      "description": "Nombre"
                    },
                    "especificacionesRelevantes": {
                      "type": "string",
                      "description": "Especificaciones relevantes"
                    },
                    "cantidad": {
                      "type": "integer",
                      "description": "Cantidad"
                    },
                    "precioUnitarioEstimado": {
                      "type": "number",
                      "description": "Precio unitario estimado"
                    }
                  }
                }
              },
              "observaciones": {
                "type": "string",
                "description": "Observaciones"
              },
              "autorizacionCliente": {
                "type": "object",
                "description": "Autorización o rechazo individual del cliente",
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "autorizado",
                      "rechazado"
                    ],
                    "description": "Decisión"
                  },
                  "fecha": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Fecha"
                  },
                  "comentarios": {
                    "type": "string",
                    "description": "Comentarios"
                  }
                }
              }
            }
          }
        },
        "valorEstimadoPropuesta": {
          "type": "number",
          "description": "Valor estimado de la propuesta calculado"
        }
      }
    },
    "ejecucion": {
      "type": "object",
      "description": "Desarrollo de cada trabajo autorizado",
      "properties": {
        "trabajosRealizados": {
          "type": "array",
          "description": "Trabajos autorizados ejecutados",
          "items": {
            "type": "object",
            "required": [
              "responsable",
              "fechaInicio",
              "fechaFinalizacion",
              "estado",
              "descripcionRealizada"
            ],
            "properties": {
              "responsable": {
                "type": "string",
                "description": "Responsable"
              },
              "fechaInicio": {
                "type": "string",
                "format": "date-time",
                "description": "Fecha de inicio"
              },
              "fechaFinalizacion": {
                "type": "string",
                "format": "date-time",
                "description": "Fecha de finalización"
              },
              "estado": {
                "type": "string",
                "description": "Estado"
              },
              "descripcionRealizada": {
                "type": "string",
                "description": "Descripción de lo realizado"
              },
              "repuestosUtilizados": {
                "type": "array",
                "description": "Repuestos efectivamente utilizados",
                "items": {
                  "type": "object",
                  "required": [
                    "nombre",
                    "cantidad",
                    "precioUnitarioAplicado"
                  ],
                  "properties": {
                    "nombre": {
                      "type": "string",
                      "description": "Nombre"
                    },
                    "cantidad": {
                      "type": "integer",
                      "description": "Cantidad"
                    },
                    "precioUnitarioAplicado": {
                      "type": "number",
                      "description": "Precio unitario aplicado"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "historialCambiosEstado": {
      "type": "array",
      "minItems": 1,
      "description": "Historial de cambios de estado",
      "items": {
        "type": "object",
        "required": [
          "fecha",
          "usuarioResponsable",
          "observacion"
        ],
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha"
          },
          "usuarioResponsable": {
            "type": "string",
            "description": "Usuario responsable"
          },
          "observacion": {
            "type": "string",
            "description": "Observación"
          },
          "estado": {
            "type": "string",
            "description": "Estado asociado"
          }
        }
      }
    },
    "revisionEntrega": {
      "type": "object",
      "description": "Al finalizar los trabajos se registrará una revisión de entrega",
      "properties": {
        "puntosVerificados": {
          "type": "array",
          "description": "Puntos verificados",
          "items": {
            "type": "object",
            "required": [
              "punto",
              "resultado"
            ],
            "properties": {
              "punto": {
                "type": "string",
                "description": "Punto verificado"
              },
              "resultado": {
                "type": "boolean",
                "description": "Resultado"
              }
            }
          }
        },
        "resultado": {
          "type": "string",
          "description": "Resultado general"
        },
        "recomendacionesUsoMantenimiento": {
          "type": "string",
          "description": "Recomendaciones de uso o mantenimiento"
        },
        "aprobada": {
          "type": "boolean",
          "description": "Revisión aprobada"
        }
      }
    },
    "entrega": {
      "type": "object",
      "description": "Al entregar la bicicleta",
      "properties": {
        "fecha": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha"
        },
        "confirmacionRecepcionCliente": {
          "type": "boolean",
          "description": "Confirmación de recepción del cliente"
        }
      }
    },
    "garantias": {
      "type": "array",
      "description": "Garantía de servicio a los trabajos que corresponda",
      "items": {
        "type": "object",
        "required": [
          "duracion",
          "fechaInicio",
          "condiciones",
          "exclusiones"
        ],
        "properties": {
          "duracion": {
            "type": "string",
            "description": "Duración"
          },
          "fechaInicio": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de inicio"
          },
          "condiciones": {
            "type": "string",
            "description": "Condiciones"
          },
          "exclusiones": {
            "type": "string",
            "description": "Exclusiones"
          },
          "solicitudes": {
            "type": "array",
            "description": "Solicitud vinculada con el trabajo original si hay inconveniente",
            "items": {
              "type": "object",
              "required": [
                "descripcion",
                "fecha",
                "evidencias",
                "estado"
              ],
              "properties": {
                "descripcion": {
                  "type": "string",
                  "description": "Descripción"
                },
                "fecha": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Fecha"
                },
                "evidencias": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Evidencias"
                },
                "estado": {
                  "type": "string",
                  "description": "Estado"
                },
                "procede": {
                  "type": "boolean",
                  "description": "Si la solicitud procede"
                },
                "solucionAplicada": {
                  "type": "string",
                  "description": "Solución aplicada"
                }
              }
            }
          }
        }
      }
    },
    "valoracion": {
      "type": "object",
      "description": "Valorar los servicios de las órdenes entregadas",
      "properties": {
        "calificacionNumerica": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Calificación numérica"
        },
        "comentarios": {
          "type": "string",
          "description": "Comentarios"
        },
        "sugerencias": {
          "type": "string",
          "description": "Sugerencias"
        }
      }
    }
  }
}