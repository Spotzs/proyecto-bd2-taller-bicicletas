{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "citas",
  "type": "object",
  "required": [
    "clienteId",
    "bicicletaId",
    "fecha",
    "hora",
    "motivo",
    "estado"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Identificador"
    },
    "clienteId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Cliente"
    },
    "bicicletaId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Bicicleta"
    },
    "fecha": {
      "type": "string",
      "description": "Fecha de la cita"
    },
    "hora": {
      "type": "string",
      "description": "Hora de la cita"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo de la visita"
    },
    "problemasObservados": {
      "type": "string",
      "description": "Problemas observados descritos por el cliente"
    },
    "serviciosInteres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Servicios de interés indicados por el cliente"
    },
    "estado": {
      "type": "string",
      "enum": [
        "solicitada",
        "confirmada",
        "atendida",
        "cancelada"
      ],
      "description": "Estado de la cita"
    },
    "observacionCambio": {
      "type": "string",
      "description": "Observación sobre el cambio de horario por el coordinador"
    },
    "coordinadorId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Coordinador que confirma o modifica disponibilidad"
    }
  }
}