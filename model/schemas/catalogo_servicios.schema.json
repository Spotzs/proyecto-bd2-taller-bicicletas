{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "catalogo_servicios",
  "type": "object",
  "required": [
    "nombre",
    "categoria",
    "descripcion",
    "duracionEstimada",
    "precioReferencia"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Identificador"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del servicio"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "mantenimiento preventivo",
        "frenos",
        "transmisión",
        "ruedas",
        "suspensión",
        "componentes eléctricos"
      ],
      "description": "Categoría del servicio"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción"
    },
    "duracionEstimada": {
      "type": "string",
      "description": "Duración estimada"
    },
    "precioReferencia": {
      "type": "number",
      "description": "Precio de referencia"
    },
    "tareasHabituales": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de tareas habituales"
    },
    "recomendaciones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recomendaciones generales"
    }
  }
}