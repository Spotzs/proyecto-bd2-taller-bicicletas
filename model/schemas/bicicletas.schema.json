{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bicicletas",
  "type": "object",
  "required": [
    "propietarioId",
    "marca",
    "modelo",
    "tipo",
    "color",
    "caracteristicasComunes"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Identificador único"
    },
    "propietarioId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Propietario de la bicicleta"
    },
    "marca": {
      "type": "string",
      "description": "Marca"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "urbana",
        "ruta",
        "montaña",
        "eléctrica"
      ],
      "description": "Tipo de bicicleta"
    },
    "color": {
      "type": "string",
      "description": "Color"
    },
    "numeroSerie": {
      "type": [
        "string",
        "null"
      ],
      "description": "Número de serie cuando esté disponible"
    },
    "caracteristicasComunes": {
      "type": "object",
      "required": [
        "tamanoMarco",
        "material",
        "tamanoRueda",
        "tipoFrenos",
        "transmision"
      ],
      "description": "Características técnicas comunes",
      "properties": {
        "tamanoMarco": {
          "type": "string",
          "description": "Tamaño del marco"
        },
        "material": {
          "type": "string",
          "description": "Material"
        },
        "tamanoRueda": {
          "type": "string",
          "description": "Tamaño de rueda"
        },
        "tipoFrenos": {
          "type": "string",
          "description": "Tipo de frenos"
        },
        "transmision": {
          "type": "string",
          "description": "Transmisión"
        }
      }
    },
    "especificacionesTipo": {
      "type": "object",
      "description": "Características técnicas que varían según el tipo",
      "properties": {
        "suspension": {
          "type": "string",
          "description": "Suspensión (montaña)"
        },
        "recorrido": {
          "type": "string",
          "description": "Recorrido (montaña)"
        },
        "bateria": {
          "type": "string",
          "description": "Batería (eléctrica)"
        },
        "motor": {
          "type": "string",
          "description": "Motor (eléctrica)"
        }
      }
    }
  }
}