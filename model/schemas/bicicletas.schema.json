{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bicicletas",
  "type": "object",
  "required": [
    "propietarioId",
    "marca",
    "modelo",
    "tipo",
    "color",
    "caracteristicasComunes",
    "fechaRegistro",
    "activo"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$"
    },
    "propietarioId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Referencia a usuarios._id"
    },
    "marca": {
      "type": "string"
    },
    "modelo": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "urbana",
        "ruta",
        "montaña",
        "eléctrica"
      ]
    },
    "color": {
      "type": "string"
    },
    "numeroSerie": {
      "type": [
        "string",
        "null"
      ]
    },
    "caracteristicasComunes": {
      "type": "object",
      "required": [
        "tamanoMarco",
        "material",
        "tamanoRueda",
        "tipoFrenos",
        "transmision"
      ],
      "properties": {
        "tamanoMarco": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "tamanoRueda": {
          "type": "string"
        },
        "tipoFrenos": {
          "type": "string"
        },
        "transmision": {
          "type": "string"
        }
      }
    },
    "especificacionesTipo": {
      "type": "object",
      "properties": {
        "suspension": {
          "type": "string"
        },
        "recorrido": {
          "type": "string"
        },
        "bateria": {
          "type": "string"
        },
        "motor": {
          "type": "string"
        }
      }
    },
    "fechaRegistro": {
      "type": "string",
      "format": "date-time"
    },
    "activo": {
      "type": "boolean"
    }
  }
}