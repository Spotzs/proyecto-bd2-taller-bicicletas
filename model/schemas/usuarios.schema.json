{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "usuarios",
  "type": "object",
  "required": [
    "nombreCompleto",
    "documentoIdentificacion",
    "correoElectronico",
    "numeroTelefono",
    "rol"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "Identificador único"
    },
    "nombreCompleto": {
      "type": "string",
      "description": "Nombre completo del usuario"
    },
    "documentoIdentificacion": {
      "type": "string",
      "description": "Documento de identificación"
    },
    "correoElectronico": {
      "type": "string",
      "format": "email",
      "description": "Correo electrónico"
    },
    "numeroTelefono": {
      "type": "string",
      "description": "Número de teléfono"
    },
    "rol": {
      "type": "string",
      "enum": [
        "cliente",
        "tecnico",
        "coordinador",
        "administrador"
      ],
      "description": "Uno de los cuatro roles del sistema"
    },
    "direccion": {
      "type": "string",
      "description": "Dirección registrada por clientes"
    }
  }
}