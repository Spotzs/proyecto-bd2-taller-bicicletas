{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "usuarios",
  "type": "object",
  "required": [
    "nombre",
    "documento",
    "correo",
    "telefono",
    "rol",
    "fechaCreacion",
    "activo"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "ObjectId de MongoDB"
    },
    "nombre": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "documento": {
      "type": "string",
      "pattern": "^[0-9A-Za-z-]{5,20}$"
    },
    "correo": {
      "type": "string",
      "format": "email"
    },
    "telefono": {
      "type": "string"
    },
    "rol": {
      "type": "string",
      "enum": [
        "cliente",
        "tecnico",
        "coordinador",
        "administrador"
      ]
    },
    "direccion": {
      "type": "string"
    },
    "fechaCreacion": {
      "type": "string",
      "format": "date-time"
    },
    "activo": {
      "type": "boolean"
    }
  }
}